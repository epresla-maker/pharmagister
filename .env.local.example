# Firebase konfiguráció
# FONTOS: Ugyanazt a Firebase projektet használod mint a Nexus!
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# Market/domain szeparáció (HU/DE)
NEXT_PUBLIC_MARKET_HU_URL=https://pharmagister.hu
NEXT_PUBLIC_MARKET_DE_URL=https://pharmagister.de
MARKET_HU_DOMAIN=pharmagister.hu
MARKET_DE_DOMAIN=pharmagister.de

# Stripe konfiguráció
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# RevenueCat + natív IAP konfiguráció (iOS / Android)
# Nyilvános SDK kulcsok - kliensoldalon is használva
NEXT_PUBLIC_REVENUECAT_APPLE_API_KEY=appl_your_revenuecat_public_sdk_key
NEXT_PUBLIC_REVENUECAT_GOOGLE_API_KEY=goog_your_revenuecat_public_sdk_key

# Store product azonosítók a 4 kredites csomaghoz
NEXT_PUBLIC_REVENUECAT_IOS_PRODUCT_ID_REGULAR=pharmagister_4_credits_regular
NEXT_PUBLIC_REVENUECAT_ANDROID_PRODUCT_ID_REGULAR=pharmagister_4_credits_regular
NEXT_PUBLIC_REVENUECAT_IOS_PRODUCT_ID_FOUNDER=pharmagister_4_credits_founder
NEXT_PUBLIC_REVENUECAT_ANDROID_PRODUCT_ID_FOUNDER=pharmagister_4_credits_founder

# RevenueCat webhook hitelesítés (szerveroldali)
REVENUECAT_WEBHOOK_AUTH_TOKEN=your_revenuecat_webhook_bearer_token
REVENUECAT_WEBHOOK_HMAC_SECRET=your_revenuecat_webhook_hmac_secret

# AI / MCP külső eszközök (Play Console, App Store Connect, web automáció)
# Fontos: ezek a valós titkos adatok NEM kerülnek a repo-ba; ezt a fájlt csak példaként használod.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=/absolute/path/to/service-account.json
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PLAY_PACKAGE_NAME=com.your.app
APP_STORE_KEY_ID=your_app_store_key_id
APP_STORE_ISSUER_ID=your_app_store_issuer_id
APP_STORE_P8_PATH=/absolute/path/to/AuthKey_xxxxxx.p8
APP_STORE_BUNDLE_ID=com.your.app
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium
