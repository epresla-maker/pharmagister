rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin hozzáférés - admin email címmel rendelkező user mindent elérhet
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'epresla@icloud.com';
    }
    
    // Bejelentkezett user ellenőrzés
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pharmagisterRole;
    }

    function hasPharmagisterRole() {
      return isAuthenticated() && currentUserRole() in ['pharmacy', 'pharmacist', 'assistant', 'pka', 'employee'];
    }

    function canAccessScheduleManager() {
      return hasPharmagisterRole();
    }

    function isSchedulePharmacyOwner(data) {
      return canAccessScheduleManager() && currentUserRole() == 'pharmacy' && data.pharmacyId == request.auth.uid;
    }

    function isScheduleLinkedUser(data) {
      return canAccessScheduleManager() && (
        data.linkedUserId == request.auth.uid ||
        data.userId == request.auth.uid ||
        data.requesterUserId == request.auth.uid ||
        data.targetUserId == request.auth.uid ||
        data.email == request.auth.token.email ||
        data.employeeEmail == request.auth.token.email
      );
    }

    function isSchedulePublished(data) {
      return canAccessScheduleManager() && data.publishedAt != null;
    }

    function employeePreferenceFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'avoidWeekdays',
        'preferWeekdays',
        'preferredShiftType',
        'preferredWeekend',
        'preferredNight',
        'canWorkWeekends',
        'canWorkNight',
        'targetWeeklyHours',
        'schedulingNotes',
        'updatedAt'
      ]);
    }
    
    // Users collection
    match /users/{userId} {
      // Olvasás: csak bejelentkezett userek (saját adat + mások profil megtekintéséhez)
      allow read: if isAuthenticated();
      
      // Írás: csak saját profil
      allow create, delete: if isAuthenticated() && request.auth.uid == userId;
      
      // Update: saját profil VAGY email verifikáció VAGY pharmaRating frissítés (értékelés után)
      allow update: if (isAuthenticated() && request.auth.uid == userId) ||
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerified', 'verificationToken', 'verificationTokenExpires']) &&
                        request.resource.data.emailVerified == true) ||
                       (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pharmaRating', 'pharmaRatingUpdatedAt']));
    }
    
    // Pharmagister collections
    match /pharmacies/{pharmacyId} {
      allow read, write: if isAdmin() || isAuthenticated();
    }
    
    match /gigs/{gigId} {
      allow read, write: if isAdmin() || isAuthenticated();
    }
    
    match /applications/{applicationId} {
      allow read, write: if isAdmin() || isAuthenticated();
    }
    
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
    
    match /chats/{chatId} {
      allow read, write: if isAdmin() || isAuthenticated();
      
      // Messages subcollection — explicit szabály szükséges
      match /messages/{messageId} {
        allow read, write: if isAdmin() || isAuthenticated();
      }
    }
    
    // Pharmagister-specifikus collections
    match /pharmaDemands/{demandId} {
      allow read, write: if isAdmin() || isAuthenticated();
    }
    
    match /pharmaApplications/{applicationId} {
      allow read, write: if isAdmin() || isAuthenticated();
    }
    
    match /pharmagisterApprovals/{approvalId} {
      allow read, write: if isAdmin() || isAuthenticated();
    }
    
    // Service feed
    match /serviceFeedPosts/{postId} {
      allow read, write: if isAdmin() || isAuthenticated();
    }
    
    // RSS Comments
    match /rssComments/{postId} {
      allow read: if true;
      allow write: if isAuthenticated();
      
      match /comments/{commentId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }
    
    // Hidden RSS Posts (csak admin kezelheti)
    match /hiddenRssPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Reports collection - users can create reports
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }
    
    // Blocked Users collection - users can manage their own blocks
    match /blockedUsers/{blockId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.blockerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.blockerId == request.auth.uid;
    }
    
    // User settings - users can manage their own settings
    match /userSettings/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Állandóra keres posts
    match /allandoKeresPosts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Push subscriptions - user can manage their own
    match /pushSubscriptions/{subId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Appointments
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Substitution requests
    match /substitutionRequests/{requestId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Ratings - pharmacies can rate substitutes
    match /ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.pharmacyId == request.auth.uid;
    }

    // Pharmagister schedule manager collections
    match /pharmacyEmployees/{employeeId} {
      allow read: if isAdmin() || isSchedulePharmacyOwner(resource.data) || isScheduleLinkedUser(resource.data);
      allow create: if isAdmin() || isSchedulePharmacyOwner(request.resource.data);
      allow update: if isAdmin() ||
        (isSchedulePharmacyOwner(resource.data) && request.resource.data.pharmacyId == resource.data.pharmacyId) ||
        (isScheduleLinkedUser(resource.data) && employeePreferenceFieldsOnly());
      allow delete: if isAdmin() || isSchedulePharmacyOwner(resource.data);
    }

    match /pharmacySchedules/{scheduleId} {
      allow read: if isAdmin() || isSchedulePharmacyOwner(resource.data) || isScheduleLinkedUser(resource.data) || isSchedulePublished(resource.data);
      allow create: if isAdmin() || isSchedulePharmacyOwner(request.resource.data);
      allow update, delete: if isAdmin() || isSchedulePharmacyOwner(resource.data);
    }

    match /scheduleSwapRequests/{requestId} {
      allow read: if isAdmin() || isSchedulePharmacyOwner(resource.data) || isScheduleLinkedUser(resource.data);
      allow create: if isAdmin() || isSchedulePharmacyOwner(request.resource.data) ||
        (canAccessScheduleManager() && request.resource.data.requesterUserId == request.auth.uid);
      allow update: if isAdmin() || isSchedulePharmacyOwner(resource.data) || isScheduleLinkedUser(resource.data);
      allow delete: if isAdmin() || isSchedulePharmacyOwner(resource.data);
    }

    match /scheduleVacationRequests/{requestId} {
      allow read: if isAdmin() || isSchedulePharmacyOwner(resource.data) || isScheduleLinkedUser(resource.data);
      allow create: if isAdmin() || (canAccessScheduleManager() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || isSchedulePharmacyOwner(resource.data) || isScheduleLinkedUser(resource.data);
      allow delete: if isAdmin() || isSchedulePharmacyOwner(resource.data) || isScheduleLinkedUser(resource.data);
    }

    match /schedulePreferences/{prefId} {
      allow read: if isAdmin() || isScheduleLinkedUser(resource.data) || isSchedulePublished(resource.data) ||
        (isSchedulePharmacyOwner(resource.data) && resource.data.publishedAt != null);
      allow create: if isAdmin() || (canAccessScheduleManager() && (
        request.resource.data.linkedUserId == request.auth.uid ||
        request.resource.data.employeeEmail == request.auth.token.email
      ));
      allow update, delete: if isAdmin() || (canAccessScheduleManager() && (
        resource.data.linkedUserId == request.auth.uid ||
        request.resource.data.linkedUserId == request.auth.uid ||
        resource.data.employeeEmail == request.auth.token.email ||
        request.resource.data.employeeEmail == request.auth.token.email
      ));
    }
    
    // Sent emails - admin only
    match /sentEmails/{emailId} {
      allow read, write: if isAdmin();
    }
    
    // Account action tokens - server only (admin SDK bypasses rules)
    match /accountActionTokens/{tokenId} {
      allow read, write: if false;
    }
    
    // Firestore stats - authenticated users can update counters, admin full access
    match /firestoreStats/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAuthenticated();
    }
    
    // KTK kereső stats
    match /stats/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      
      match /visits/{visitId} {
        allow read: if isAdmin();
        allow create: if isAuthenticated();
      }
    }
    
    // Shortage items (Hiánycikk kereső) - anyone authenticated can read, create own entries
    match /shortage_items/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdByUserId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.createdByUserId == request.auth.uid || isAdmin());
    }
    
    // Community posts (Közösség - anonim posztok)
    match /communityPosts/{postId} {
      allow read: if isAuthenticated();
      allow create: if hasPharmagisterRole();
      allow update: if hasPharmagisterRole();
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if hasPharmagisterRole();
        allow update: if hasPharmagisterRole();
        allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }
    
    // Employee profiles (Alap adataim - szabadság, szerződés típus)
    match /employeeProfiles/{profileId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Deny everything else by default (no wildcard catch-all)
  }
}
