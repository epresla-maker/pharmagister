rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin hozzáférés - admin email címmel rendelkező user mindent elérhet
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'epresla@icloud.com';
    }
    
    // Bejelentkezett user ellenőrzés
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Users collection
    match /users/{userId} {
      // Olvasás: csak bejelentkezett userek (saját adat + mások profil megtekintéséhez)
      allow read: if isAuthenticated();
      
      // Írás: csak saját profil
      allow create, delete: if isAuthenticated() && request.auth.uid == userId;
      
      // Update: saját profil VAGY email verifikáció VAGY pharmaRating frissítés (értékelés után)
      allow update: if (isAuthenticated() && request.auth.uid == userId) ||
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerified', 'verificationToken', 'verificationTokenExpires']) &&
                        request.resource.data.emailVerified == true) ||
                       (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pharmaRating', 'pharmaRatingUpdatedAt']));
    }
    
    // Pharmagister collections
    match /pharmacies/{pharmacyId} {
      allow read, write: if isAdmin() || isAuthenticated();
    }
    
    match /gigs/{gigId} {
      allow read, write: if isAdmin() || isAuthenticated();
    }
    
    match /applications/{applicationId} {
      allow read, write: if isAdmin() || isAuthenticated();
    }
    
    match /notifications/{notificationId} {
      allow read, write: if isAdmin() || isAuthenticated();
    }
    
    match /chats/{chatId} {
      allow read, write: if isAdmin() || isAuthenticated();
      
      // Messages subcollection — explicit szabály szükséges
      match /messages/{messageId} {
        allow read, write: if isAdmin() || isAuthenticated();
      }
    }
    
    // Pharmagister-specifikus collections
    match /pharmaDemands/{demandId} {
      allow read, write: if isAdmin() || isAuthenticated();
    }
    
    match /pharmaApplications/{applicationId} {
      allow read, write: if isAdmin() || isAuthenticated();
    }
    
    match /pharmagisterApprovals/{approvalId} {
      allow read, write: if isAdmin() || isAuthenticated();
    }
    
    // Service feed
    match /serviceFeedPosts/{postId} {
      allow read, write: if isAdmin() || isAuthenticated();
    }
    
    // RSS Comments
    match /rssComments/{postId} {
      allow read: if true;
      allow write: if isAuthenticated();
      
      match /comments/{commentId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }
    
    // Hidden RSS Posts (csak admin kezelheti)
    match /hiddenRssPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Reports collection - users can create reports
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }
    
    // Blocked Users collection - users can manage their own blocks
    match /blockedUsers/{blockId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.blockerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.blockerId == request.auth.uid;
    }
    
    // User settings - users can manage their own settings
    match /userSettings/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Állandóra keres posts
    match /allandoKeresPosts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Push subscriptions - user can manage their own
    match /pushSubscriptions/{subId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Appointments
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Substitution requests
    match /substitutionRequests/{requestId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Ratings - pharmacies can rate substitutes
    match /ratings/{ratingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.pharmacyId == request.auth.uid;
    }
    
    // Sent emails - admin only
    match /sentEmails/{emailId} {
      allow read, write: if isAdmin();
    }
    
    // Account action tokens - server only (admin SDK bypasses rules)
    match /accountActionTokens/{tokenId} {
      allow read, write: if false;
    }
    
    // Firestore stats - authenticated users can update counters, admin full access
    match /firestoreStats/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isAuthenticated();
    }
    
    // KTK kereső stats
    match /stats/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      
      match /visits/{visitId} {
        allow read: if isAdmin();
        allow create: if isAuthenticated();
      }
    }
    
    // Shortage items (Hiánycikk kereső) - anyone authenticated can read, create own entries
    match /shortage_items/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.createdByUserId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.createdByUserId == request.auth.uid || isAdmin());
    }
    
    // Community posts (Közösség - anonim posztok)
    match /communityPosts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }
    
    // Deny everything else by default (no wildcard catch-all)
  }
}
